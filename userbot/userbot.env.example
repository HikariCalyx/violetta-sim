# Copy this to /etc/violetta-userbot.env (chmod 600) on the VPS.
# systemd reads it through EnvironmentFile=; the Python script itself does not load it.
USERBOT_API_ID=123456
API_HASH_SECRET=0123456789abcdef0123456789abcdef
USERBOT_SESSION=1BQANOTEuMTA4LjU2LjE2OAG7...

# Optional. Defaults are fine for the production Worker and for a long-running VPS.
WORKER_ORIGIN=https://violetta.trill.workers.dev
MAX_RUNTIME_SECONDS=0
TRIGGER_MAX_AGE_SECONDS=1800
