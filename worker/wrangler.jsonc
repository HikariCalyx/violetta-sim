{
  // Cloudflare Worker that gates members of a Telegram group behind the mini-game.
  // Deploy from this directory: `npm install && npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "violetta",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-23",

  // The game bundle, served by this Worker so the page and the API share one origin
  // (no CORS). `dist/` is git-ignored, so build it from the repo root first:
  //   trunk build --release
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "ChatRegistry" },
      { "name": "USER_INDEX", "class_name": "UserIndex" },
      { "name": "SESSION", "class_name": "VerificationSession" },
      // The PM userbot's cleanup outbox (verified chats to unblock and messages to delete).
      { "name": "USERBOT_INBOX", "class_name": "UserbotInbox" }
    ]
  },
  // SQLite-backed Durable Objects are the ones that exist on the Workers Free plan.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRegistry", "UserIndex", "VerificationSession"]
    },
    // A new tag is required for a class that did not exist in v1.
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserbotInbox"]
    }
  ],

  "vars": {
    "BOT_USERNAME": "hctViolettaBot",
    "VERIFY_ORIGIN": "https://violetta.trill.workers.dev"
  },

  // Secrets are never stored here; set them once per environment:
  //   npx wrangler secret put BOT_TOKEN
  //   npx wrangler secret put WEBHOOK_SECRET
  //   npx wrangler secret put USERBOT_API_HASH   # optional: enables /api/userbot/*

  // Serving on a domain of your own needs that domain to be a ZONE on this same Cloudflare
  // account — `*.workers.dev` can never be a custom domain. Once that is true, uncomment
  // this and point both the pattern and VERIFY_ORIGIN above at it:
  // "routes": [{ "pattern": "violetta.example.com", "custom_domain": true }],

  "observability": { "enabled": true }
}
